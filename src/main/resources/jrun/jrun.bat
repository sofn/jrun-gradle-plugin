@echo off
rem ===========================================================================
rem  jrun - run Java like uv / cargo / npm scripts (Windows CMD version)
rem
rem    jrun Hello.java                  single-file source mode
rem    jrun com.example.demo.App         classpath mode (Spring Boot etc.)
rem    jrun <script-name>                run a script from jrun { scripts }
rem    jrun build|test|clean|classes     shortcut for the Gradle task
rem    jrun init                         regenerate the argfile cache (same as "gradle jrunInit")
rem    jrun --rebuild <target>           refresh the cache, then run
rem    jrun --help
rem
rem  This file is generated by jrun-gradle-plugin - do not edit by hand.
rem  Keep it ASCII-only: the console code page may be GBK/CP936.
rem  Requires CRLF line endings (the plugin writes them).
rem ===========================================================================
setlocal EnableExtensions EnableDelayedExpansion
set "JRUN_VERSION=@JRUN_VERSION@"
set "ORIG_DIR=%CD%"
set "SCRIPT_DIR=%~dp0"
if "%SCRIPT_DIR:~-1%"=="\" set "SCRIPT_DIR=%SCRIPT_DIR:~0,-1%"
rem Same file, two roles: the project's own launcher, or the global command
rem (no build file next to it), which creates projects and delegates to them
if not exist "%SCRIPT_DIR%\build.gradle.kts" if not exist "%SCRIPT_DIR%\build.gradle" goto global_main

cd /d "%SCRIPT_DIR%"
set "OUT_DIR=build\jrun"
rem argfiles are platform specific: Windows and WSL share build/, so keep them apart
set "ARGS_DIR=%OUT_DIR%\win"
call :find_gradlew "%CD%"
set "ARG_SOURCE=%CD%\%ARGS_DIR%\source.args"
set "ARG_CLASS=%CD%\%ARGS_DIR%\class.args"
set "FORCE_REBUILD=0"

rem ---------------------------------------------------------------------------
rem  Parse arguments
rem
rem  NOTE: "%1" is expanded at PARSE time, and a raw "=" in an argument such as
rem  "--server.port=8080" is treated as a separator there - the value silently
rem  becomes "--server.port 8080". Routing the raw argument through a variable
rem  (delayed expansion) keeps it intact.
rem ---------------------------------------------------------------------------
set "TARGET="
set "APP_ARGS="
set "REMAIN=%*"
:parse
set "FIRST="
set "REST="
for /f "tokens=1,*" %%A in ("!REMAIN!") do (
    set "FIRST=%%A"
    set "REST=%%B"
)
if not defined FIRST goto after_parse
if /i "!FIRST!"=="--rebuild" (
    set "FORCE_REBUILD=1"
    set "REMAIN=!REST!"
    goto parse
)
if /i "!FIRST!"=="-r" (
    set "FORCE_REBUILD=1"
    set "REMAIN=!REST!"
    goto parse
)
if /i "!FIRST!"=="--help" goto show_help
if /i "!FIRST!"=="-h" goto show_help
if not defined TARGET if /i "!FIRST!"=="--version" goto print_version
if not defined TARGET if /i "!FIRST!"=="-V" goto print_version
if not defined TARGET if /i "!FIRST!"=="-m" goto module_dispatch
if not defined TARGET if /i "!FIRST!"=="--module" goto module_dispatch
if not defined TARGET (
    set "TARGET=!FIRST!"
) else (
    set "APP_ARGS=!APP_ARGS! !FIRST!"
)
set "REMAIN=!REST!"
goto parse

:after_parse
if not defined TARGET (
    if exist "%OUT_DIR%\default-target.txt" (
        set /p TARGET=<"%OUT_DIR%\default-target.txt"
    )
)
if not defined TARGET (
    echo Usage: jrun ^<file.java ^| a.b.C ^| script-name^> [args...] 1>&2
    exit /b 1
)

rem ---------------------------------------------------------------------------
rem  Built-in Gradle shortcuts
rem ---------------------------------------------------------------------------
for %%T in (build test clean classes jar check) do (
    if /i "!TARGET!"=="%%T" (
        call "!GRADLEW!" %%T !APP_ARGS!
        exit /b !ERRORLEVEL!
    )
)
rem NOTE: "init" must be handled BEFORE the generic Gradle task loop, because
rem Gradle has its own built-in "init" task and we want jrunInit instead.
if /i "!TARGET!"=="init" (
    call "!GRADLEW!" jrunInit !APP_ARGS!
    exit /b !ERRORLEVEL!
)
if /i "!TARGET!"=="prepare" (
    call "!GRADLEW!" jrunInit !APP_ARGS!
    exit /b !ERRORLEVEL!
)

rem ---------------------------------------------------------------------------
rem  Locate a working java (the Oracle javapath shim on PATH is often broken)
rem ---------------------------------------------------------------------------
set "JAVA_BIN="
call :try_java "%JAVA_HOME%\bin\java.exe"
if not defined JAVA_BIN call :try_java "%JDK_HOME%\bin\java.exe"
if not defined JAVA_BIN (
    for %%J in (java.exe) do call :try_java "%%~$PATH:J"
)
if not defined JAVA_BIN (
    echo No usable java found. Set JAVA_HOME to a JDK 11+ install directory. 1>&2
    exit /b 1
)
rem Gradle must use the very same JDK
for %%I in ("!JAVA_BIN!") do set "JAVA_HOME=%%~dpI.."
if "!JAVA_HOME:~-1!"=="\" set "JAVA_HOME=!JAVA_HOME:~0,-1!"

if /i "!TARGET!"=="add" goto add_dependencies

rem ---------------------------------------------------------------------------
rem  Ensure the argfile cache exists and is fresh
rem  (content hashes of the build inputs; --rebuild forces a refresh)
rem ---------------------------------------------------------------------------
if not exist "%ARGS_DIR%\source.args" goto do_prepare
if not exist "%ARGS_DIR%\class.args" goto do_prepare
if "%FORCE_REBUILD%"=="1" goto do_prepare
call :inputs_fresh
if errorlevel 1 goto do_prepare
goto after_prepare

:do_prepare
echo Preparing runtime ^(Gradle jrunInit^)... 1>&2
call "!GRADLEW!" --quiet --console=plain jrunInit
if errorlevel 1 exit /b 1
if not exist "%ARGS_DIR%\source.args" (
    echo Missing %ARGS_DIR%\source.args - run: gradlew jrunInit 1>&2
    exit /b 1
)

:after_prepare
rem ---------------------------------------------------------------------------
rem  Named scripts: build\jrun\scripts\<name>.properties (kind/target/deps) and
rem  <name>.args (fixed Java arguments, already quoted for an @argfile)
rem ---------------------------------------------------------------------------
set "SCRIPTS_DIR=%OUT_DIR%\scripts"
set "IS_SCRIPT=0"
if exist "%SCRIPTS_DIR%\!TARGET!.properties" (
    echo !TARGET!| findstr /r /x "[A-Za-z0-9][A-Za-z0-9._-]*" >nul && set "IS_SCRIPT=1"
)
if "!IS_SCRIPT!"=="1" (
    call :run_script "!TARGET!" final
    exit /b !ERRORLEVEL!
)

rem ---------------------------------------------------------------------------
rem  Execute a direct target
rem    Java      -> single-file source mode (no .class produced)
rem    others    -> no such mode; compile first, then launch by class name
rem ---------------------------------------------------------------------------
set "FIXED_FILE="
set "RS_NAME="
set "FINAL_ARGS=!APP_ARGS!"
call :run_java_target
exit /b !ERRORLEVEL!

rem ===========================================================================
rem  Subroutines
rem ===========================================================================
:run_script
rem %1 = script name, %2 = "final" for the script the user asked for (gets APP_ARGS)
setlocal
set "RS_NAME=%~1"
set "RS_KIND="
set "RS_TARGET="
set "RS_DEPS="
for /f "usebackq tokens=1,* delims==" %%A in ("%SCRIPTS_DIR%\%~1.properties") do (
    if "%%A"=="kind" set "RS_KIND=%%B"
    if "%%A"=="target" set "RS_TARGET=%%B"
    if "%%A"=="deps" set "RS_DEPS=%%B"
)
for %%D in (!RS_DEPS!) do (
    call :run_script "%%D" dep
    if errorlevel 1 (
        echo jrun: script '%%D' ^(dependency of '!RS_NAME!'^) failed 1>&2
        endlocal & exit /b 1
    )
)
set "FINAL_ARGS="
if /i "%~2"=="final" set "FINAL_ARGS=!APP_ARGS!"
if /i "!RS_KIND!"=="gradle" goto rs_gradle
if /i "!RS_KIND!"=="shell" goto rs_shell
set "TARGET=!RS_TARGET!"
set "FIXED_FILE=%CD%\%SCRIPTS_DIR%\!RS_NAME!.args"
call :run_java_target
goto rs_done
:rs_gradle
call "!GRADLEW!" !RS_TARGET! !FINAL_ARGS!
goto rs_done
:rs_shell
cmd /d /c "!RS_TARGET! !FINAL_ARGS!"
goto rs_done
:rs_done
set "RC=!ERRORLEVEL!"
endlocal & exit /b %RC%

:run_java_target
rem Uses TARGET, FIXED_FILE (fixed-args file or empty), RS_NAME and FINAL_ARGS
set "EXT="
for %%F in ("!TARGET!") do set "EXT=%%~xF"
if /i "!EXT!"==".java" goto rjt_source
if /i "!EXT!"==".kt" goto rjt_jvm
if /i "!EXT!"==".groovy" goto rjt_jvm
if /i "!EXT!"==".scala" goto rjt_jvm
rem Keep build/classes and the jars of other modules in sync (incremental, usually fast)
call "!GRADLEW!" --quiet --console=plain jrunInit
if errorlevel 1 exit /b 1
set "PROGRAM=!TARGET!"
set "RUNTIME=!ARG_CLASS!"
goto rjt_launch
:rjt_source
call :locate_source "!TARGET!"
if not exist "!TARGET!" (
    echo Source file not found: !TARGET! 1>&2
    exit /b 1
)
call :strip_shebang
set "PROGRAM=!TARGET!"
set "RUNTIME=!ARG_SOURCE!"
goto rjt_launch
:rjt_jvm
call :locate_source "!TARGET!"
if not exist "!TARGET!" (
    echo Source file not found: !TARGET! 1>&2
    exit /b 1
)
call :derive_jvm_main "!TARGET!"
call "!GRADLEW!" --quiet --console=plain jrunInit
if errorlevel 1 exit /b 1
set "PROGRAM=!MAIN_CLASS!"
set "RUNTIME=!ARG_CLASS!"
:rjt_launch
if defined FIXED_FILE if exist "!FIXED_FILE!" for %%S in ("!FIXED_FILE!") do if %%~zS GTR 0 goto rjt_argfile
"!JAVA_BIN!" %JAVA_OPTS% %JRUN_OPTS% "@!RUNTIME!" "!PROGRAM!" !FINAL_ARGS!
exit /b !ERRORLEVEL!
:rjt_argfile
rem Main class / source + fixed arguments go into one @argfile: no CMD word splitting
if not exist "%ARGS_DIR%\run" mkdir "%ARGS_DIR%\run"
set "RUN_FILE=%CD%\%ARGS_DIR%\run\!RS_NAME!.args"
set "QUOTED=!PROGRAM:\=\\!"
> "!RUN_FILE!" echo "!QUOTED!"
type "!FIXED_FILE!" >> "!RUN_FILE!"
"!JAVA_BIN!" %JAVA_OPTS% %JRUN_OPTS% "@!RUNTIME!" "@!RUN_FILE!" !FINAL_ARGS!
exit /b !ERRORLEVEL!

:add_dependencies
rem Edit first, then resolve + refresh in a fresh build; restore the backup on failure
set "ADD_CFG=implementation"
set "ADD_DEPS="
set "REMAIN=!APP_ARGS!"
:add_parse
set "FIRST="
set "REST="
for /f "tokens=1,*" %%A in ("!REMAIN!") do (
    set "FIRST=%%A"
    set "REST=%%B"
)
if not defined FIRST goto add_run
if /i "!FIRST!"=="--test" (
    set "ADD_CFG=testImplementation"
) else if /i "!FIRST!"=="--config" (
    for /f "tokens=1,*" %%A in ("!REST!") do (
        set "ADD_CFG=%%A"
        set "REST=%%B"
    )
) else if /i "!FIRST:~0,9!"=="--config=" (
    set "ADD_CFG=!FIRST:~9!"
) else (
    set ADD_DEPS=!ADD_DEPS! "--dependency=!FIRST!"
)
set "REMAIN=!REST!"
goto add_parse
:add_run
if not defined ADD_DEPS (
    echo Usage: jrun add [--test ^| --config ^<name^>] ^<group:artifact[:version]^>... 1>&2
    exit /b 1
)
set "BUILD_FILE=build.gradle.kts"
if not exist "!BUILD_FILE!" set "BUILD_FILE=build.gradle"
if not exist "%OUT_DIR%" mkdir "%OUT_DIR%"
copy /y "!BUILD_FILE!" "%OUT_DIR%\!BUILD_FILE!.bak" >nul
call "!GRADLEW!" --quiet --console=plain jrunAdd "--configuration=!ADD_CFG!" !ADD_DEPS!
if errorlevel 1 goto add_restore
call "!GRADLEW!" --quiet --console=plain jrunResolve "--configuration=!ADD_CFG!" jrunInit
if errorlevel 1 goto add_restore
del "%OUT_DIR%\!BUILD_FILE!.bak" >nul 2>&1
echo Added to !BUILD_FILE! ^(!ADD_CFG!^)
exit /b 0
:add_restore
copy /y "%OUT_DIR%\!BUILD_FILE!.bak" "!BUILD_FILE!" >nul
del "%OUT_DIR%\!BUILD_FILE!.bak" >nul 2>&1
echo jrun add: dependency resolution failed, restored !BUILD_FILE! 1>&2
exit /b 1

:inputs_fresh
rem Re-hash every build input listed by jrunInit (inputs.sha256, sha256sum format).
rem Any changed or missing file means the argfiles may be stale. Sources are kept
rem fresh by the "gradlew jrunInit" call before class-mode runs.
if not exist "%ARGS_DIR%\inputs.sha256" exit /b 1
set "STALE=0"
for /f "usebackq tokens=1,*" %%H in ("%ARGS_DIR%\inputs.sha256") do (
    set "IN_PATH=%%I"
    set "IN_PATH=!IN_PATH:/=\!"
    if not exist "!IN_PATH!" (
        set "STALE=1"
    ) else (
        set "ACTUAL="
        for /f "delims=" %%L in ('certutil -hashfile "!IN_PATH!" SHA256 ^| findstr /v ":"') do (
            if not defined ACTUAL set "ACTUAL=%%L"
        )
        set "ACTUAL=!ACTUAL: =!"
        if /i not "!ACTUAL!"=="%%H" set "STALE=1"
    )
)
exit /b %STALE%

:try_java
if not "%~1"=="" if exist "%~1" (
    "%~1" -version >nul 2>&1
    if not errorlevel 1 set "JAVA_BIN=%~1"
)
exit /b 0

:strip_shebang
rem javac rejects "#!"; the JDK only skips that line for files without the
rem .java extension, so run an extensionless copy. Only the first character is
rem compared: a literal "!" would be eaten by delayed expansion, and Java
rem sources never start with "#".
set "FIRST_LINE="
set /p FIRST_LINE=<"!TARGET!"
if not "!FIRST_LINE:~0,1!"=="#" exit /b 0
if not exist "%OUT_DIR%\shebang" mkdir "%OUT_DIR%\shebang"
for %%F in ("!TARGET!") do set "SHEBANG_COPY=%OUT_DIR%\shebang\%%~nF"
copy /y "!TARGET!" "!SHEBANG_COPY!" >nul
set "TARGET=!SHEBANG_COPY!"
exit /b 0

:locate_source
rem Resolve the source file: the caller's directory, as given, then under main\
if exist "%ORIG_DIR%\%~1" (
    set "TARGET=%ORIG_DIR%\%~1"
    exit /b 0
)
if exist "%~1" (
    set "TARGET=%~1"
    exit /b 0
)
if exist "main\%~1" (
    set "TARGET=main\%~1"
    exit /b 0
)
exit /b 0

:derive_jvm_main
rem Read the package declaration and build the main class name.
rem   Kotlin top-level main compiles to "<File>Kt"; a Groovy script keeps "<File>".
rem For a main declared inside class/object, pass the FQCN explicitly instead.
set "PKG="
for /f "tokens=2" %%P in ('findstr /r /c:"package " ^< "%~1"') do (
    if not defined PKG set "PKG=%%P"
)
if defined PKG if "!PKG:~-1!"==";" set "PKG=!PKG:~0,-1!"
for %%F in ("%~1") do set "BASE=%%~nF"
set "PREFIX="
if defined PKG set "PREFIX=!PKG!."
set "SUFFIX="
if /i "!EXT!"==".kt" set "SUFFIX=Kt"
set "MAIN_CLASS=!PREFIX!!BASE!!SUFFIX!"
exit /b 0

:print_version
echo jrun %JRUN_VERSION%
exit /b 0

:module_dispatch
rem jrun -m <module> <command>: module dir from the root's modules.properties,
rem falling back to the convention a:b -> a\b
set "MODULE="
set "MODULE_ARGS="
for /f "tokens=1,*" %%A in ("!REST!") do (
    set "MODULE=%%A"
    set "MODULE_ARGS=%%B"
)
if not defined MODULE (
    echo Usage: jrun -m ^<module^> ^<command^> [args...] 1>&2
    exit /b 1
)
set "MODULE_DIR="
if exist "%OUT_DIR%\modules.properties" (
    for /f "usebackq tokens=1,* delims==" %%A in ("%OUT_DIR%\modules.properties") do (
        if "%%A"=="!MODULE!" if not defined MODULE_DIR set "MODULE_DIR=%%B"
    )
)
if not defined MODULE_DIR (
    set "MODULE_DIR=!MODULE!"
    if "!MODULE_DIR:~0,1!"==":" set "MODULE_DIR=!MODULE_DIR:~1!"
    set "MODULE_DIR=!MODULE_DIR::=\!"
)
set "MODULE_DIR=!MODULE_DIR:/=\!"
if not exist "!MODULE_DIR!\jrun.bat" (
    echo jrun: module '!MODULE!' has no launcher ^(!MODULE_DIR!\jrun.bat^) 1>&2
    exit /b 1
)
call "!MODULE_DIR!\jrun.bat" !MODULE_ARGS!
exit /b !ERRORLEVEL!

:find_gradlew
rem In multi-module builds gradlew.bat lives in the build root: search upwards
set "GRADLEW=gradle"
set "FG_DIR=%~1"
:fg_loop
if exist "!FG_DIR!\gradlew.bat" (
    set "GRADLEW=!FG_DIR!\gradlew.bat"
    exit /b 0
)
for %%I in ("!FG_DIR!\..") do set "FG_PARENT=%%~fI"
if /i "!FG_PARENT!"=="!FG_DIR!" exit /b 0
set "FG_DIR=!FG_PARENT!"
goto fg_loop

:global_main
rem Global command (e.g. %USERPROFILE%\.local\bin\jrun.bat): delegate to the nearest
rem project's own launcher so the project pins its jrun version (like gradlew)
if /i "%~1"=="--version" goto print_version
if /i "%~1"=="-V" goto print_version
if /i "%~1"=="--help" goto show_help
if /i "%~1"=="-h" goto show_help
if /i "%~1"=="init" goto global_init
set "DIR=%ORIG_DIR%"
:global_walk
if exist "!DIR!\build.gradle.kts" goto global_found
if exist "!DIR!\build.gradle" goto global_found
goto global_up
:global_found
if exist "!DIR!\jrun.bat" (
    call "!DIR!\jrun.bat" %*
    exit /b !ERRORLEVEL!
)
findstr /m /c:"com.archforge.jrun" "!DIR!\build.gradle.kts" "!DIR!\build.gradle" >nul 2>&1
if errorlevel 1 goto global_up
echo Generating the project launcher ^(Gradle jrunInit^)... 1>&2
pushd "!DIR!"
call :find_gradlew "!DIR!"
call "!GRADLEW!" --quiet --console=plain jrunInit
set "RC=!ERRORLEVEL!"
popd
if not "!RC!"=="0" exit /b !RC!
call "!DIR!\jrun.bat" %*
exit /b !ERRORLEVEL!
:global_up
for %%I in ("!DIR!\..") do set "PARENT=%%~fI"
if /i "!PARENT!"=="!DIR!" goto global_none
set "DIR=!PARENT!"
goto global_walk
:global_none
echo jrun: not inside a jrun project. Create one with: jrun init ^<dir^> 1>&2
exit /b 1

:global_init
set "TARGET_DIR=%~2"
if not defined TARGET_DIR set "TARGET_DIR=."
if not exist "!TARGET_DIR!" mkdir "!TARGET_DIR!"
pushd "!TARGET_DIR!" || exit /b 1
set "TARGET_DIR=!CD!"
popd
if exist "!TARGET_DIR!\build.gradle.kts" goto init_exists
if exist "!TARGET_DIR!\build.gradle" goto init_exists
for %%I in ("!TARGET_DIR!") do set "PROJECT_NAME=%%~nxI"
set "SETTINGS=!TARGET_DIR!\settings.gradle.kts"
type nul > "!SETTINGS!"
if not defined JRUN_PLUGIN_DIR goto init_settings_name
for %%I in ("%JRUN_PLUGIN_DIR%") do set "PLUGIN_DIR=%%~fI"
set "PLUGIN_DIR=!PLUGIN_DIR:\=/!"
>>"!SETTINGS!" echo pluginManagement {
>>"!SETTINGS!" echo     includeBuild("!PLUGIN_DIR!")
>>"!SETTINGS!" echo }
>>"!SETTINGS!" echo.
:init_settings_name
>>"!SETTINGS!" echo rootProject.name = "!PROJECT_NAME!"
set "BUILD=!TARGET_DIR!\build.gradle.kts"
>"!BUILD!" echo plugins {
>>"!BUILD!" echo     id("com.archforge.jrun") version "%JRUN_VERSION%"
>>"!BUILD!" echo }
>>"!BUILD!" echo.
>>"!BUILD!" echo // Dependencies go here, or run: jrun add ^<group:artifact:version^>
>>"!BUILD!" echo dependencies {
>>"!BUILD!" echo }
>>"!BUILD!" echo.
>>"!BUILD!" echo jrun {
>>"!BUILD!" echo     mainClass = "Main"
>>"!BUILD!" echo }
if not exist "!TARGET_DIR!\main" mkdir "!TARGET_DIR!\main"
set "MAIN=!TARGET_DIR!\main\Main.java"
if exist "!MAIN!" goto init_gitignore
>"!MAIN!" echo public class Main {
>>"!MAIN!" echo     public static void main(String[] args) {
>>"!MAIN!" echo         System.out.println("Hello from jrun");
>>"!MAIN!" echo     }
>>"!MAIN!" echo }
:init_gitignore
if exist "!TARGET_DIR!\.gitignore" goto init_wrapper
>"!TARGET_DIR!\.gitignore" echo build/
>>"!TARGET_DIR!\.gitignore" echo .gradle/
>>"!TARGET_DIR!\.gitignore" echo .idea/
>>"!TARGET_DIR!\.gitignore" echo *.iml
:init_wrapper
set "TEMPLATE=%JRUN_HOME%"
if not defined TEMPLATE set "TEMPLATE=%LOCALAPPDATA%\jrun"
set "TEMPLATE=!TEMPLATE!\wrapper"
if not exist "!TEMPLATE!\gradle\wrapper\gradle-wrapper.jar" goto init_launcher
if exist "!TARGET_DIR!\gradlew.bat" goto init_launcher
if not exist "!TARGET_DIR!\gradle\wrapper" mkdir "!TARGET_DIR!\gradle\wrapper"
copy /y "!TEMPLATE!\gradlew" "!TARGET_DIR!\" >nul
copy /y "!TEMPLATE!\gradlew.bat" "!TARGET_DIR!\" >nul
copy /y "!TEMPLATE!\gradle\wrapper\gradle-wrapper.jar" "!TARGET_DIR!\gradle\wrapper\" >nul
copy /y "!TEMPLATE!\gradle\wrapper\gradle-wrapper.properties" "!TARGET_DIR!\gradle\wrapper\" >nul
:init_launcher
copy /y "%~f0" "!TARGET_DIR!\jrun.bat" >nul
echo Created jrun project: !TARGET_DIR!
echo   cd "!TARGET_DIR!" ^&^& jrun
exit /b 0
:init_exists
echo jrun init: !TARGET_DIR! is already a Gradle project 1>&2
exit /b 1

:show_help
echo jrun - run Java like uv / cargo / npm scripts ^(Windows CMD version^)
echo.
echo   jrun init [dir]                  create a new jrun project ^(global command^)
echo   jrun Hello.java                  single-file source mode
echo   jrun com.example.demo.App         classpath mode ^(Spring Boot etc.^)
echo   jrun ^<script-name^>                run a script from jrun { scripts }
echo   jrun add [--test] ^<g:a:v^>...       add dependencies to build.gradle(.kts)
echo   jrun -m ^<module^> ^<command^>         run a command in a sub-module
echo   jrun build^|test^|clean^|classes     shortcut for the Gradle task
echo   jrun init                         regenerate the argfile cache
echo   jrun --rebuild ^<target^>           refresh the cache, then run
echo   jrun --version
echo.
echo   JVM options: JAVA_OPTS, then JRUN_OPTS ^(the later one wins^)
if exist "%OUT_DIR%\scripts.properties" (
    echo.
    echo Available scripts ^(declared in jrun { scripts }^):
    type "%OUT_DIR%\scripts.properties"
)
exit /b 0
