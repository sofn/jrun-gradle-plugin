@echo off
rem ===========================================================================
rem  jrun - run Java like uv / cargo / npm scripts (Windows CMD version)
rem
rem    jrun Hello.java                  single-file source mode
rem    jrun com.example.demo.App         classpath mode (Spring Boot etc.)
rem    jrun <script-name>                run a script from jrun { scripts }
rem    jrun build|test|clean|classes     shortcut for the Gradle task
rem    jrun init                         regenerate the argfile cache (same as "gradle jrunInit")
rem    jrun --rebuild <target>           refresh the cache, then run
rem    jrun --help
rem
rem  This file is generated by jrun-gradle-plugin - do not edit by hand.
rem  Keep it ASCII-only: the console code page may be GBK/CP936.
rem  Requires CRLF line endings (the plugin writes them).
rem ===========================================================================
setlocal EnableExtensions EnableDelayedExpansion
set "JRUN_VERSION=@JRUN_VERSION@"
set "ORIG_DIR=%CD%"

cd /d "%~dp0"
set "OUT_DIR=build\jrun"
rem argfiles are platform specific: Windows and WSL share build/, so keep them apart
set "ARGS_DIR=%OUT_DIR%\win"
set "GRADLEW=gradlew.bat"
if not exist "%GRADLEW%" set "GRADLEW=gradle"
set "ARG_SOURCE=%CD%\%ARGS_DIR%\source.args"
set "ARG_CLASS=%CD%\%ARGS_DIR%\class.args"
set "FORCE_REBUILD=0"

rem ---------------------------------------------------------------------------
rem  Parse arguments
rem
rem  NOTE: "%1" is expanded at PARSE time, and a raw "=" in an argument such as
rem  "--server.port=8080" is treated as a separator there - the value silently
rem  becomes "--server.port 8080". Routing the raw argument through a variable
rem  (delayed expansion) keeps it intact.
rem ---------------------------------------------------------------------------
set "TARGET="
set "APP_ARGS="
set "REMAIN=%*"
:parse
set "FIRST="
set "REST="
for /f "tokens=1,*" %%A in ("!REMAIN!") do (
    set "FIRST=%%A"
    set "REST=%%B"
)
if not defined FIRST goto after_parse
if /i "!FIRST!"=="--rebuild" (
    set "FORCE_REBUILD=1"
    set "REMAIN=!REST!"
    goto parse
)
if /i "!FIRST!"=="-r" (
    set "FORCE_REBUILD=1"
    set "REMAIN=!REST!"
    goto parse
)
if /i "!FIRST!"=="--help" goto show_help
if /i "!FIRST!"=="-h" goto show_help
if not defined TARGET (
    set "TARGET=!FIRST!"
) else (
    set "APP_ARGS=!APP_ARGS! !FIRST!"
)
set "REMAIN=!REST!"
goto parse

:after_parse
if not defined TARGET (
    if exist "%OUT_DIR%\default-target.txt" (
        set /p TARGET=<"%OUT_DIR%\default-target.txt"
    )
)
if not defined TARGET (
    echo Usage: jrun ^<file.java ^| a.b.C ^| script-name^> [args...] 1>&2
    exit /b 1
)

rem ---------------------------------------------------------------------------
rem  Built-in Gradle shortcuts
rem ---------------------------------------------------------------------------
for %%T in (build test clean classes jar check) do (
    if /i "!TARGET!"=="%%T" (
        call "%GRADLEW%" %%T !APP_ARGS!
        exit /b !ERRORLEVEL!
    )
)
rem NOTE: "init" must be handled BEFORE the generic Gradle task loop, because
rem Gradle has its own built-in "init" task and we want jrunInit instead.
if /i "!TARGET!"=="init" (
    call "%GRADLEW%" jrunInit !APP_ARGS!
    exit /b !ERRORLEVEL!
)
if /i "!TARGET!"=="prepare" (
    call "%GRADLEW%" jrunInit !APP_ARGS!
    exit /b !ERRORLEVEL!
)

rem ---------------------------------------------------------------------------
rem  Locate a working java (the Oracle javapath shim on PATH is often broken)
rem ---------------------------------------------------------------------------
set "JAVA_BIN="
call :try_java "%JAVA_HOME%\bin\java.exe"
if not defined JAVA_BIN call :try_java "%JDK_HOME%\bin\java.exe"
if not defined JAVA_BIN (
    for %%J in (java.exe) do call :try_java "%%~$PATH:J"
)
if not defined JAVA_BIN (
    echo No usable java found. Set JAVA_HOME to a JDK 11+ install directory. 1>&2
    exit /b 1
)
rem Gradle must use the very same JDK
for %%I in ("!JAVA_BIN!") do set "JAVA_HOME=%%~dpI.."
if "!JAVA_HOME:~-1!"=="\" set "JAVA_HOME=!JAVA_HOME:~0,-1!"

rem ---------------------------------------------------------------------------
rem  Ensure the argfile cache exists and is fresh
rem  (content hashes of the build inputs; --rebuild forces a refresh)
rem ---------------------------------------------------------------------------
if not exist "%ARGS_DIR%\source.args" goto do_prepare
if not exist "%ARGS_DIR%\class.args" goto do_prepare
if "%FORCE_REBUILD%"=="1" goto do_prepare
call :inputs_fresh
if errorlevel 1 goto do_prepare
goto after_prepare

:do_prepare
echo Preparing runtime ^(Gradle jrunInit^)... 1>&2
call "%GRADLEW%" --quiet --console=plain jrunInit
if errorlevel 1 exit /b 1
if not exist "%ARGS_DIR%\source.args" (
    echo Missing %ARGS_DIR%\source.args - run: gradlew jrunInit 1>&2
    exit /b 1
)

:after_prepare
rem ---------------------------------------------------------------------------
rem  Named scripts: build\jrun\scripts\<name>.properties (kind/target/deps) and
rem  <name>.args (fixed Java arguments, already quoted for an @argfile)
rem ---------------------------------------------------------------------------
set "SCRIPTS_DIR=%OUT_DIR%\scripts"
set "IS_SCRIPT=0"
if exist "%SCRIPTS_DIR%\!TARGET!.properties" (
    echo !TARGET!| findstr /r /x "[A-Za-z0-9][A-Za-z0-9._-]*" >nul && set "IS_SCRIPT=1"
)
if "!IS_SCRIPT!"=="1" (
    call :run_script "!TARGET!" final
    exit /b !ERRORLEVEL!
)

rem ---------------------------------------------------------------------------
rem  Execute a direct target
rem    Java      -> single-file source mode (no .class produced)
rem    others    -> no such mode; compile first, then launch by class name
rem ---------------------------------------------------------------------------
set "FIXED_FILE="
set "RS_NAME="
set "FINAL_ARGS=!APP_ARGS!"
call :run_java_target
exit /b !ERRORLEVEL!

rem ===========================================================================
rem  Subroutines
rem ===========================================================================
:run_script
rem %1 = script name, %2 = "final" for the script the user asked for (gets APP_ARGS)
setlocal
set "RS_NAME=%~1"
set "RS_KIND="
set "RS_TARGET="
set "RS_DEPS="
for /f "usebackq tokens=1,* delims==" %%A in ("%SCRIPTS_DIR%\%~1.properties") do (
    if "%%A"=="kind" set "RS_KIND=%%B"
    if "%%A"=="target" set "RS_TARGET=%%B"
    if "%%A"=="deps" set "RS_DEPS=%%B"
)
for %%D in (!RS_DEPS!) do (
    call :run_script "%%D" dep
    if errorlevel 1 (
        echo jrun: script '%%D' ^(dependency of '!RS_NAME!'^) failed 1>&2
        endlocal & exit /b 1
    )
)
set "FINAL_ARGS="
if /i "%~2"=="final" set "FINAL_ARGS=!APP_ARGS!"
if /i "!RS_KIND!"=="gradle" goto rs_gradle
if /i "!RS_KIND!"=="shell" goto rs_shell
set "TARGET=!RS_TARGET!"
set "FIXED_FILE=%CD%\%SCRIPTS_DIR%\!RS_NAME!.args"
call :run_java_target
goto rs_done
:rs_gradle
call "%GRADLEW%" !RS_TARGET! !FINAL_ARGS!
goto rs_done
:rs_shell
cmd /d /c "!RS_TARGET! !FINAL_ARGS!"
goto rs_done
:rs_done
set "RC=!ERRORLEVEL!"
endlocal & exit /b %RC%

:run_java_target
rem Uses TARGET, FIXED_FILE (fixed-args file or empty), RS_NAME and FINAL_ARGS
set "EXT="
for %%F in ("!TARGET!") do set "EXT=%%~xF"
if /i "!EXT!"==".java" goto rjt_source
if /i "!EXT!"==".kt" goto rjt_jvm
if /i "!EXT!"==".groovy" goto rjt_jvm
if /i "!EXT!"==".scala" goto rjt_jvm
rem Keep build/classes in sync with the sources (incremental, usually fast)
call "%GRADLEW%" --quiet --console=plain classes
if errorlevel 1 exit /b 1
set "PROGRAM=!TARGET!"
set "RUNTIME=!ARG_CLASS!"
goto rjt_launch
:rjt_source
call :locate_source "!TARGET!"
if not exist "!TARGET!" (
    echo Source file not found: !TARGET! 1>&2
    exit /b 1
)
call :strip_shebang
set "PROGRAM=!TARGET!"
set "RUNTIME=!ARG_SOURCE!"
goto rjt_launch
:rjt_jvm
call :locate_source "!TARGET!"
if not exist "!TARGET!" (
    echo Source file not found: !TARGET! 1>&2
    exit /b 1
)
call :derive_jvm_main "!TARGET!"
call "%GRADLEW%" --quiet --console=plain classes
if errorlevel 1 exit /b 1
set "PROGRAM=!MAIN_CLASS!"
set "RUNTIME=!ARG_CLASS!"
:rjt_launch
if defined FIXED_FILE if exist "!FIXED_FILE!" for %%S in ("!FIXED_FILE!") do if %%~zS GTR 0 goto rjt_argfile
"!JAVA_BIN!" %JAVA_OPTS% %JRUN_OPTS% "@!RUNTIME!" "!PROGRAM!" !FINAL_ARGS!
exit /b !ERRORLEVEL!
:rjt_argfile
rem Main class / source + fixed arguments go into one @argfile: no CMD word splitting
if not exist "%ARGS_DIR%\run" mkdir "%ARGS_DIR%\run"
set "RUN_FILE=%CD%\%ARGS_DIR%\run\!RS_NAME!.args"
set "QUOTED=!PROGRAM:\=\\!"
> "!RUN_FILE!" echo "!QUOTED!"
type "!FIXED_FILE!" >> "!RUN_FILE!"
"!JAVA_BIN!" %JAVA_OPTS% %JRUN_OPTS% "@!RUNTIME!" "@!RUN_FILE!" !FINAL_ARGS!
exit /b !ERRORLEVEL!

:inputs_fresh
rem Re-hash every build input listed by jrunInit (inputs.sha256, sha256sum format).
rem Any changed or missing file means the argfiles may be stale. Sources are kept
rem fresh by the "gradlew classes" call before class-mode runs.
if not exist "%ARGS_DIR%\inputs.sha256" exit /b 1
set "STALE=0"
for /f "usebackq tokens=1,*" %%H in ("%ARGS_DIR%\inputs.sha256") do (
    set "IN_PATH=%%I"
    set "IN_PATH=!IN_PATH:/=\!"
    if not exist "!IN_PATH!" (
        set "STALE=1"
    ) else (
        set "ACTUAL="
        for /f "delims=" %%L in ('certutil -hashfile "!IN_PATH!" SHA256 ^| findstr /v ":"') do (
            if not defined ACTUAL set "ACTUAL=%%L"
        )
        set "ACTUAL=!ACTUAL: =!"
        if /i not "!ACTUAL!"=="%%H" set "STALE=1"
    )
)
exit /b %STALE%

:try_java
if not "%~1"=="" if exist "%~1" (
    "%~1" -version >nul 2>&1
    if not errorlevel 1 set "JAVA_BIN=%~1"
)
exit /b 0

:strip_shebang
rem javac rejects "#!"; the JDK only skips that line for files without the
rem .java extension, so run an extensionless copy. Only the first character is
rem compared: a literal "!" would be eaten by delayed expansion, and Java
rem sources never start with "#".
set "FIRST_LINE="
set /p FIRST_LINE=<"!TARGET!"
if not "!FIRST_LINE:~0,1!"=="#" exit /b 0
if not exist "%OUT_DIR%\shebang" mkdir "%OUT_DIR%\shebang"
for %%F in ("!TARGET!") do set "SHEBANG_COPY=%OUT_DIR%\shebang\%%~nF"
copy /y "!TARGET!" "!SHEBANG_COPY!" >nul
set "TARGET=!SHEBANG_COPY!"
exit /b 0

:locate_source
rem Resolve the source file: the caller's directory, as given, then under main\
if exist "%ORIG_DIR%\%~1" (
    set "TARGET=%ORIG_DIR%\%~1"
    exit /b 0
)
if exist "%~1" (
    set "TARGET=%~1"
    exit /b 0
)
if exist "main\%~1" (
    set "TARGET=main\%~1"
    exit /b 0
)
exit /b 0

:derive_jvm_main
rem Read the package declaration and build the main class name.
rem   Kotlin top-level main compiles to "<File>Kt"; a Groovy script keeps "<File>".
rem For a main declared inside class/object, pass the FQCN explicitly instead.
set "PKG="
for /f "tokens=2" %%P in ('findstr /r /c:"package " ^< "%~1"') do (
    if not defined PKG set "PKG=%%P"
)
if defined PKG if "!PKG:~-1!"==";" set "PKG=!PKG:~0,-1!"
for %%F in ("%~1") do set "BASE=%%~nF"
set "PREFIX="
if defined PKG set "PREFIX=!PKG!."
set "SUFFIX="
if /i "!EXT!"==".kt" set "SUFFIX=Kt"
set "MAIN_CLASS=!PREFIX!!BASE!!SUFFIX!"
exit /b 0

:show_help
echo jrun - run Java like uv / cargo / npm scripts ^(Windows CMD version^)
echo.
echo   jrun Hello.java                  single-file source mode
echo   jrun com.example.demo.App         classpath mode ^(Spring Boot etc.^)
echo   jrun ^<script-name^>                run a script from jrun { scripts }
echo   jrun build^|test^|clean^|classes     shortcut for the Gradle task
echo   jrun init                         regenerate the argfile cache
echo   jrun --rebuild ^<target^>           refresh the cache, then run
echo.
echo   JVM options: JAVA_OPTS, then JRUN_OPTS ^(the later one wins^)
if exist "%OUT_DIR%\scripts.properties" (
    echo.
    echo Available scripts ^(declared in jrun { scripts }^):
    type "%OUT_DIR%\scripts.properties"
)
exit /b 0
