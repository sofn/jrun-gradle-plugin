# 默认按文本处理，仓库内统一存 LF
* text=auto eol=lf

# POSIX 脚本必须保持 LF，否则 Linux/macOS/CI 上会报 "bad interpreter: /bin/sh^M"
*.sh    text eol=lf
gradlew text eol=lf

# Windows 批处理必须 CRLF（CMD 的 goto/label 解析要求）
*.bat   text eol=crlf

# 例外：这是插件模板资源，仓库里保持 LF，
# 插件生成 .bat 时会自己转成 CRLF（JrunPlugin#writeLauncher）
src/main/resources/jrun/jrun.bat text eol=lf

# 二进制
*.jar   binary
gradle-wrapper.jar binary
